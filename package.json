{
    "name": "theaniketraj",
    "displayName": "Aniket Raj Personal Portfolio",
    "description": "A high-performance, accessible, and beautifully designed personal website.",
    "version": "2.0.0",
    "author": "Aniket Raj",
    "repository": {
        "type": "git",
        "url": "https://github.com/theaniketraj/personal-portfolio"
    },
    "bugs": {
        "url": "https://github.com/theaniketraj/personal-portfolio/issues"
    },
    "keywords": [
        "portfolio",
        "personal-portfolio",
        "portfolio-website"
    ],
    "homepage": "https://theaniketraj.netlify.app",
    "license": "MIT",
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:og": "tsx scripts/generate-og-images.ts --watch",
        "build:og": "tsx scripts/generate-og-images.ts",
        "build": "npm run lint && npm run build:og && npm run test:unit && next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "npm run lint && npm run test:unit && npm run test:e2e",
        "test:ci": "npm run lint && npm run test:unit && npm run build && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:webmcp": "tsx tests/webmcp-registry.test.ts",
        "test:content": "tsx tests/content-integrity.test.ts",
        "test:webmcp-simulation": "tsx tests/webmcp-registration-simulation.test.ts",
        "test:unit": "npm run test:content && npm run test:webmcp && npm run test:webmcp-simulation"
    },
    "dependencies": {
        "@netlify/plugin-nextjs": "^5.16.7",
        "@radix-ui/react-slot": "^1.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "github-slugger": "^2.0.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^1.73.0",
        "next": "^16.4.5",
        "next-mdx-remote": "^6.0.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rehype-pretty-code": "^0.14.5",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.5",
        "shiki": "^4.6.0",
        "tailwind-merge": "^3.7.0",
        "webmcp-types": "^0.1.11",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.15.0",
        "eslint-config-next": "^16.4.5",
        "jsdom": "^31.0.1",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2"
    }
}
